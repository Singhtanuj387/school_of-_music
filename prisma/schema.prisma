generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  emailVerified           DateTime?
  name                    String?
  image                   String?
  passwordHash            String?
  timezone                String                    @default("UTC")
  phone                   String?                   @unique
  phoneVerified           DateTime?
  role                    Role                      @default(STUDENT)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(6)
  address                 String?
  age                     Int?
  country                 String?
  gender                  String?
  guardianName            String?
  guardianPhone           String?
  accounts                Account[]
  conversationsAsStudent  Conversation[]            @relation("ConversationStudent")
  conversationsAsTeacher  Conversation[]            @relation("ConversationTeacher")
  courseRequestsAsStudent CourseEnrollmentRequest[] @relation("StudentCourseRequests")
  allottedCourseLessons   CourseLesson[]            @relation("CourseLessonTeacher")
  courseTeachers          CourseTeacher[]
  sentMessages            DirectMessage[]           @relation("MessageSender")
  enrollments             Enrollment[]
  eventsAsTeacher         Event[]                   @relation("TeacherEvents")
  eventRegistrations      EventRegistration[]
  lessonsAsStudent        Lesson[]                  @relation("StudentLessons")
  lessonsAsTeacher        Lesson[]                  @relation("TeacherLessons")
  notifications           Notification[]
  payments                Payment[]
  resourcesUploaded       Resource[]                @relation("TeacherResources")
  resourcesReceived       ResourceShare[]           @relation("StudentReceivedResources")
  sessions                Session[]
  trialStatus             StudentTrialStatus?
  supportTickets          SupportTicket[]
  teacherProfile          TeacherProfile?
  allottedTrialsAsTeacher TrialRequest[]            @relation("TeacherAllottedTrials")
  trialRequestsAsStudent  TrialRequest[]            @relation("StudentTrialRequests")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([email])
}

model PhoneVerificationToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expires   DateTime @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([phone])
}

/// Singleton settings row (id = 1 always). Application-level guard enforces single row.
model PlatformSettings {
  id                   Int     @id @default(1)
  freeTrialLessonCount Int     @default(2)
  googleDriveFolderId  String?
}

/// Tracks how many free trial lessons a student has been granted and used.
/// lessonsGranted is a snapshot of PlatformSettings.freeTrialLessonCount at the
/// time the student's first booking attempt — changing the global default later
/// does NOT retroactively change existing students.
model StudentTrialStatus {
  id             Int         @id @default(autoincrement())
  studentId      String      @unique
  lessonsGranted Int
  lessonsUsed    Int         @default(0)
  status         TrialStatus @default(ACTIVE)
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  bio                    String?
  instruments            String[]
  expertInstruments      String[]                @default([])
  moderateInstruments    String[]                @default([])
  yearsTeaching          Int                     @default(0)
  hourlyRate             Int                     @default(0)
  payoutPerSession       Int                     @default(0)
  upiId                  String?
  paymentQrCodeUrl       String?
  currency               String                  @default("INR")
  languages              String[]
  isPublished            Boolean                 @default(false)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  adminNotes             String?
  approvalStatus         TeacherApprovalStatus   @default(PENDING)
  approvedAt             DateTime?               @db.Timestamptz(6)
  rejectedAt             DateTime?               @db.Timestamptz(6)
  rejectionReason        String?
  availabilityExceptions AvailabilityException[]
  availabilityRules      AvailabilityRule[]
  lessonsAsTeacher       Lesson[]
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublished])
  @@index([approvalStatus])
}

/// Weekly recurring availability pattern.
/// startMinute/endMinute are minutes from midnight in the teacher's timezone.
/// e.g. 9:00 AM = 540, 5:00 PM = 1020
model AvailabilityRule {
  id          String         @id @default(cuid())
  teacherId   String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, startMinute])
  @@index([teacherId])
}

/// One-off exceptions: holidays (blocked) or extra availability.
model AvailabilityException {
  id          String         @id @default(cuid())
  teacherId   String
  date        DateTime       @db.Date
  isBlocked   Boolean        @default(true)
  startMinute Int?
  endMinute   Int?
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date, startMinute])
  @@index([teacherId, date])
}

model Lesson {
  id                       String              @id @default(cuid())
  teacherProfileId         String
  teacherId                String
  studentId                String
  instrument               String
  startsAt                 DateTime            @db.Timestamptz(6)
  durationMinutes          Int                 @default(60)
  status                   LessonStatus        @default(SCHEDULED)
  trackingCode             String?
  lessonSource             LessonSource?
  enrollmentId             String?
  groupRoomId              String?
  cancelledBy              String?
  cancelledAt              DateTime?           @db.Timestamptz(6)
  teacherJoinedAt          DateTime?           @db.Timestamptz(6)
  studentJoinedAt          DateTime?           @db.Timestamptz(6)
  recordingUrl             String?
  recordingFileId          String?
  recordingDurationSeconds Int?
  payoutStatus             TeacherPayoutStatus @default(UNPAID)
  payoutPaidAt             DateTime?           @db.Timestamptz(6)
  payoutTransactionId      String?
  payoutNotes              String?
  payoutAmountMinor        Int?
  createdAt                DateTime            @default(now()) @db.Timestamptz(6)
  enrollment               Enrollment?         @relation(fields: [enrollmentId], references: [id])
  student                  User                @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  teacher                  User                @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherProfile           TeacherProfile      @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  recordings               LessonRecording[]
  trialRequest             TrialRequest?

  @@index([teacherProfileId, startsAt])
  @@index([teacherId, startsAt])
  @@index([studentId, startsAt])
  @@index([status])
  @@index([enrollmentId])
  @@index([groupRoomId])
  @@index([trackingCode])
  @@index([payoutStatus])
}

model LessonRecording {
  id              String   @id @default(cuid())
  lessonId        String
  fileUrl         String
  fileId          String?
  fileName        String
  fileSizeBytes   Int
  durationSeconds Int?
  storageBackend  String   @default("GOOGLE_DRIVE")
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Course {
  id                 String                    @id @default(cuid())
  title              String
  slug               String                    @unique
  discipline         Discipline
  instrument         String
  level              CourseLevel
  accreditation      String?
  description        String
  syllabusSummary    String
  priceMinorUnits    Int
  currency           String                    @default("INR")
  sessionCount       Int
  durationWeeks      Int
  thumbnailUrl       String?
  startDate          DateTime?                 @db.Timestamptz(6)
  endDate            DateTime?                 @db.Timestamptz(6)
  isPublished        Boolean                   @default(false)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(6)
  enrollmentRequests CourseEnrollmentRequest[]
  lessons            CourseLesson[]
  teachers           CourseTeacher[]
  enrollments        Enrollment[]
  resourceShares     ResourceShare[]

  @@index([isPublished])
  @@index([discipline])
  @@index([instrument])
  @@index([startDate])
}

model CourseTeacher {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([courseId])
  @@index([teacherId])
}

model CourseLesson {
  id                String    @id @default(cuid())
  courseId          String
  lessonNumber      Int
  title             String
  description       String?
  durationMinutes   Int       @default(60)
  scheduledStartsAt DateTime? @db.Timestamptz(6)
  teacherId         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher           User?     @relation("CourseLessonTeacher", fields: [teacherId], references: [id])

  @@index([courseId])
  @@index([teacherId])
  @@index([scheduledStartsAt])
}

model Enrollment {
  id                String            @id @default(cuid())
  studentId         String
  courseId          String
  teacherId         String?
  paymentId         String?           @unique
  sessionsRemaining Int
  status            EnrollmentStatus  @default(ACTIVE)
  startedAt         DateTime          @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?         @db.Timestamptz(6)
  adminNotes        String?
  emiStatus         CourseEmiStatus   @default(NOT_APPLICABLE)
  paymentPlan       CoursePaymentPlan @default(FULL_PAYMENT)
  certificate       Certificate?
  course            Course            @relation(fields: [courseId], references: [id])
  payment           Payment?          @relation(fields: [paymentId], references: [id])
  student           User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessons           Lesson[]

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model Payment {
  id               String        @id @default(cuid())
  studentId        String
  amountMinorUnits Int
  currency         String
  gateway          String
  gatewayOrderId   String        @unique
  gatewayPaymentId String?       @unique
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  enrollment       Enrollment?
  student          User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Certificate {
  id                String     @id @default(cuid())
  studentId         String
  enrollmentId      String     @unique
  certificateNumber String     @unique
  issuedAt          DateTime   @default(now()) @db.Timestamptz(6)
  pdfUrl            String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([studentId])
}

model Event {
  id              String              @id @default(cuid())
  title           String
  description     String
  type            EventType
  startsAt        DateTime            @db.Timestamptz(6)
  durationMinutes Int
  capacity        Int?
  isPublished     Boolean             @default(false)
  teacherId       String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  teacher         User?               @relation("TeacherEvents", fields: [teacherId], references: [id])
  registrations   EventRegistration[]

  @@index([isPublished, startsAt])
  @@index([teacherId])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  studentId    String
  registeredAt DateTime @default(now()) @db.Timestamptz(6)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId])
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  category  TicketCategory
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String
  senderRole Role
  body       String
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TrialRequest {
  id                String             @id @default(cuid())
  studentId         String
  category          String
  instrument        String
  requestedStartsAt DateTime           @db.Timestamptz(6)
  preferredTimeSlot String
  timezone          String             @default("UTC")
  ageGroup          String
  studentName       String
  studentEmail      String
  studentPhone      String?
  studentNotes      String?
  status            TrialRequestStatus @default(PENDING)
  allottedTeacherId String?
  allottedLessonId  String?            @unique
  allottedAt        DateTime?          @db.Timestamptz(6)
  isContacted       Boolean            @default(false)
  contactedAt       DateTime?          @db.Timestamptz(6)
  followUpAt        DateTime?          @db.Timestamptz(6)
  leadSource        String?            @default("Direct Web")
  leadIntent        String?            @default("HIGH")
  leadOwner         String?            @default("Admissions - Neha")
  isConverted       Boolean            @default(false)
  convertedAt       DateTime?          @db.Timestamptz(6)
  teacherFeedback   String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  allottedLesson    Lesson?            @relation(fields: [allottedLessonId], references: [id])
  allottedTeacher   User?              @relation("TeacherAllottedTrials", fields: [allottedTeacherId], references: [id])
  student           User               @relation("StudentTrialRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([allottedTeacherId])
  @@index([isContacted])
  @@index([isConverted])
}

/// A conversation between exactly one teacher and one student.
/// Scoped to their lesson/enrollment relationship.
model Conversation {
  id         String          @id @default(cuid())
  teacherId  String
  studentId  String
  instrument String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(6)
  student    User            @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User            @relation("ConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  messages   DirectMessage[]

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
  @@index([updatedAt])
}

/// A single message within a conversation.
/// Supports text, file attachments (PDF/DOC only), and assignments.
/// PII filtering is enforced at the application layer before persistence.
model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  messageType    MessageType  @default(TEXT)
  body           String?
  fileName       String?
  fileUrl        String?
  fileSizeBytes  Int?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([isRead])
}

/// In-app notification for any user (student, teacher, admin).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/// Educational learning resource uploaded by a teacher to Google Drive.
model Resource {
  id            String           @id @default(cuid())
  teacherId     String
  title         String
  description   String?
  category      ResourceCategory @default(SHEET_MUSIC)
  fileName      String
  fileUrl       String
  fileId        String?
  fileSizeBytes Int              @default(0)
  mimeType      String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  teacher       User             @relation("TeacherResources", fields: [teacherId], references: [id], onDelete: Cascade)
  shares        ResourceShare[]

  @@index([teacherId, createdAt])
  @@index([category])
}

/// A resource sent by a teacher to a course-allotted student.
model ResourceShare {
  id          String    @id @default(cuid())
  resourceId  String
  studentId   String
  courseId    String?
  teacherNote String?
  sharedAt    DateTime  @default(now()) @db.Timestamptz(6)
  isViewed    Boolean   @default(false)
  viewedAt    DateTime? @db.Timestamptz(6)
  course      Course?   @relation(fields: [courseId], references: [id])
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student     User      @relation("StudentReceivedResources", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([resourceId, studentId])
  @@index([studentId, sharedAt])
  @@index([resourceId])
  @@index([courseId])
}

/// Course enrollment request submitted by a student to be approved and allotted by academy admin.
model CourseEnrollmentRequest {
  id                String              @id @default(cuid())
  studentId         String
  courseId          String
  paymentPlan       CoursePaymentPlan   @default(FULL_PAYMENT)
  status            CourseRequestStatus @default(PENDING)
  studentNotes      String?
  adminNotes        String?
  preferredSchedule String?
  allottedTeacherId String?
  enrollmentId      String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  course            Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student           User                @relation("StudentCourseRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum MessageType {
  TEXT
  FILE
  ASSIGNMENT
  SYSTEM
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LessonSource {
  TRIAL
  ENROLLMENT
}

enum TrialStatus {
  ACTIVE
  EXHAUSTED
}

enum Discipline {
  INSTRUMENT
  VOCALS
  DANCE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CoursePaymentPlan {
  FULL_PAYMENT
  EMI_3_MONTHS
  EMI_6_MONTHS
}

enum CourseEmiStatus {
  NOT_APPLICABLE
  PENDING_PAYMENT
  FIRST_INSTALLMENT_PAID
  PARTIALLY_PAID
  FULLY_PAID
}

enum CourseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum EventType {
  WORKSHOP
  RECITAL
  MASTERCLASS
  EXAM_PREP
}

enum TicketCategory {
  BILLING
  TECHNICAL
  LESSON
  COURSE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TrialRequestStatus {
  PENDING
  ALLOTTED
  CANCELLED
}

enum TeacherPayoutStatus {
  UNPAID
  PAID
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_TEACHER_SIGNUP
  NEW_STUDENT_SIGNUP
  TEACHER_APPROVED
  TEACHER_REJECTED
  NEW_LESSON_BOOKED
  LESSON_CANCELLED
  LESSON_REMINDER
  NEW_ENROLLMENT
  NEW_TRIAL_REQUEST
  TRIAL_ALLOTTED
  NEW_MESSAGE
  PAYOUT_COMPLETED
  SYSTEM
  NEW_RESOURCE_SHARED
  NEW_COURSE_REQUEST
  COURSE_REQUEST_APPROVED
  COURSE_REQUEST_REJECTED
}

enum ResourceCategory {
  SHEET_MUSIC
  AUDIO_LESSON
  LESSON_NOTES
  EXERCISE
  ASSIGNMENT
  REFERENCE
  OTHER
}
